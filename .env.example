# Connect to Supabase via connection pooling with Supavisor
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for database migrations.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API credentials
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Brevo SMTP Email Configuration
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-smtp-login"
SMTP_PASS="your-brevo-smtp-key"
SMTP_FROM_EMAIL="jis@sanjib.me"
# All notification and 2FA emails will be routed to this address (sandbox/demo mode)
TO_EMAIL="registrar@example.com"

# Google Gemini AI Assistant
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL=""